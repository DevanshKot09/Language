# LINGUA AI Backend Environment Configuration (Production Hardened Template)
# NOTE: Never commit production credentials, service account JSON files, or secret keys to Git.

# Service & Environment
ENVIRONMENT=staging
DEBUG=false
ALLOWED_ORIGINS=https://lingua-ai-79735.web.app,https://lingua-ai-79735.firebaseapp.com

# Network & Request Security
ENABLE_SECURITY_HEADERS=true
MAX_REQUEST_BODY_BYTES=5242880

# Rate Limiting & Abuse Prevention
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100
RATE_LIMIT_INVITATIONS=15
RATE_LIMIT_REPORTS=10
RATE_LIMIT_AI=30

# Firebase Authentication (Server-side Firebase Admin SDK)
FIREBASE_PROJECT_ID=lingual-ai-79735
FIREBASE_CREDENTIALS_PATH=
FIREBASE_AUTH_EMULATOR_HOST=
FIREBASE_APP_CHECK_REQUIRED=false

# Database: Supabase PostgreSQL (Source of Truth for Application Data)
# Direct connection (Port 5432):
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.cjgyyatosuqabcortows.supabase.co:5432/postgres?sslmode=require
# Fallback local sqlite for development / tests only:
DATABASE_URL=sqlite:///./lingua_ai.db

# AI Provider Configuration (Google Gemini / Vertex AI)
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_CHILD_CLOUD_ALLOWED=false

# Storage & Reports
REPORTS_STORAGE_PATH=./storage/reports
